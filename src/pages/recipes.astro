---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const recipes = (await getCollection("recipes"))
  .map((recipe) => ({
    url: `/recipes/${recipe.slug ?? recipe.id}`,
    ...recipe.data,
    date: new Date(recipe.data.date),
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// "4" -> "Serves 4", but "Makes about 5 jars" stays as written
const servesLabel = (s?: string) =>
  s ? (/^[\d\s\-–]+$/.test(s) ? `Serves ${s}` : s) : undefined;

---

<Layout
  title="Recipes - Frodsham Townfield Allotments"
  description="Favourite recipes from plot holders at Frodsham Townfield Allotments"
>
  <section class="recipes-intro">
    <div class="container">
      <h1>From Plot to Plate</h1>
      <p>
        Favourite recipes from our plot holders. Got a glut of courgettes or a
        secret chutney? Share it with the rest of the site.
      </p>
    </div>
  </section>

  <section class="recipes-list">
    <div class="container">
      {
        recipes.length > 0 ? (
          <div class="grid">
            {recipes.map((recipe) => (
              <a href={recipe.url} class="recipe-card">
                {recipe.image ? (
                  <div class="recipe-photo">
                    <img src={recipe.image} alt={recipe.title} loading="lazy" />
                  </div>
                ) : (
                  <div class="recipe-photo placeholder" aria-hidden="true">
                    🍽️
                  </div>
                )}
                <div class="recipe-body">
                  <h2>{recipe.title}</h2>
                  <p>{recipe.description}</p>
                  <p class="meta">
                    {[recipe.time, servesLabel(recipe.serves)]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                  {recipe.author && <p class="author">Shared by {recipe.author}</p>}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty">
            <p>No recipes yet — check back soon!</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .recipes-intro {
    background: linear-gradient(135deg, #f8f6f3 0%, #ffffff 100%);
    padding: var(--spacing-2xl) 0 var(--spacing-xl);
    text-align: center;
  }

  .recipes-intro h1 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .recipes-intro p {
    max-width: 640px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .recipes-list {
    padding: var(--spacing-xl) 0 var(--spacing-2xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  .recipe-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 2px solid var(--color-border);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .recipe-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .recipe-photo {
    height: 180px;
    background: var(--color-neutral-darker);
  }

  .recipe-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .recipe-photo.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    background: linear-gradient(135deg, var(--color-neutral) 0%, var(--color-neutral-darker) 100%);
  }

  .recipe-body {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    flex: 1;
  }

  .recipe-body h2 {
    text-align: left;
    color: var(--color-primary);
    font-size: 1.3rem;
    margin: 0;
  }

  .recipe-body p {
    margin: 0;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .recipe-body .meta {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: auto;
    padding-top: var(--spacing-xs);
  }

  .recipe-body .author {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .empty {
    text-align: center;
    padding: var(--spacing-2xl);
    background: white;
    border-radius: var(--radius-lg);
  }
</style>
