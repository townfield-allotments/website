---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug ?? recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { title, description, author, serves, time, image, ingredients } =
  recipe.data;
const { Content } = await recipe.render();
---

<Layout title={`${title} - Recipes - Frodsham Townfield Allotments`} description={description}>
  <article class="recipe-page">
    <div class="container">
      <a href="/recipes" class="back-link">← All recipes</a>

      <header class="recipe-header">
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <ul class="facts">
          {time && <li>⏱ {time}</li>}
          {serves && <li>🍽 {/^[\d\s\-–]+$/.test(serves) ? `Serves ${serves}` : serves}</li>}
          {author && <li>👩‍🌾 Shared by {author}</li>}
        </ul>
      </header>

      {image && <img class="hero-photo" src={image} alt={title} />}

      <div class="recipe-layout">
        <aside class="ingredients">
          <h2>Ingredients</h2>
          <ul>
            {(ingredients ?? []).map((item: string) => <li>{item}</li>)}
          </ul>
        </aside>

        <div class="method">
          <h2>Method</h2>
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .recipe-page {
    padding: var(--spacing-2xl) 0;
  }

  .back-link {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--spacing-lg);
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--color-primary);
    transform: translateX(-4px);
  }

  .recipe-header {
    padding-bottom: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    text-align: left;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-md);
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 700px;
  }

  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-lg);
    margin-top: var(--spacing-md);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .hero-photo {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-xl);
    display: block;
  }

  .recipe-layout {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 2fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  h2 {
    text-align: left;
    color: var(--color-primary);
    font-size: 1.4rem;
    margin-bottom: var(--spacing-md);
  }

  .ingredients {
    background: white;
    border: 2px solid var(--color-border);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    position: sticky;
    top: 6rem;
  }

  .ingredients ul {
    list-style: none;
  }

  .ingredients li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-neutral-darker);
    line-height: 1.5;
  }

  .ingredients li:last-child {
    border-bottom: none;
  }

  .method {
    line-height: 1.8;
  }

  .method :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .method :global(h3) {
    color: var(--color-primary);
    margin: var(--spacing-lg) 0 var(--spacing-sm);
  }

  .method :global(ol),
  .method :global(ul) {
    margin: 0 0 var(--spacing-md) var(--spacing-lg);
  }

  .method :global(li) {
    margin-bottom: var(--spacing-sm);
    padding-left: 0.25rem;
  }

  .method :global(ol li::marker) {
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .recipe-page {
      padding: var(--spacing-xl) 0;
    }

    .recipe-layout {
      grid-template-columns: 1fr;
    }

    .ingredients {
      position: static;
    }
  }

  @media print {
    .back-link {
      display: none;
    }
  }
</style>
